# Base de Datos PostgreSQL + pgvector
POSTGRES_DB=agrosmart_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Orquestador n8n (Self-Hosted)
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

# Frontend (Vite) — webhook WF2
VITE_N8N_WEBHOOK_URL=http://localhost:5678/webhook/v1/query

# IA y APIs del stack actual (WF0 / WF1 / WF2)
GROQ_API_KEY=
GEMINI_API_KEY=
HUGGINGFACE_API_KEY=
MAPTILER_API_KEY=

# Observabilidad (Phoenix local + Langfuse opcional)
N8N_OTEL_ENABLED=true
N8N_AGENTS_TRACING_ENABLED=true
N8N_OTEL_EXPORTER_OTLP_ENDPOINT=http://phoenix:6006
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Open Data
MIDAGRI_API_ENDPOINT=https://datosabiertos.midagri.gob.pe/api/v1/precios
