# Base de Datos PostgreSQL + pgvector
# POSTGRES_PASSWORD = contraseña del usuario de la DB (no es una API key)
POSTGRES_DB=agrosmart_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Orquestador n8n (Self-Hosted)
N8N_HOST=localhost
N8N_PORT=5678
WEBHOOK_URL=http://localhost:5678/

# IA y APIs del stack actual (WF0 / WF1 / WF2)
# Valores reales SOLO en GitHub Secrets y en Credentials de n8n (nunca en el repo)
GROQ_API_KEY=
GEMINI_API_KEY=
HUGGINGFACE_API_KEY=
MAPTILER_API_KEY=

# Open-Meteo no requiere API key para el uso básico del flujo diario

# Observabilidad e IA Ops (Sprint 3; opcional por ahora)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Open Data MIDAGRI
MIDAGRI_API_ENDPOINT=https://datosabiertos.midagri.gob.pe/api/v1/precios
