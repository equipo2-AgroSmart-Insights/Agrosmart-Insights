# Webhook WF2 (n8n) — contrato: { pregunta, session_id }
VITE_N8N_WEBHOOK_URL=http://localhost:5678/webhook/v1/query
# Timeout del chat en milisegundos (el flujo IA en Render free suele tardar 8–20 s)
VITE_API_TIMEOUT_MS=30000

# Remotes de Module Federation (microfrontends independientes).
# En local, cada uno se sirve con `npm run preview` desde su propia carpeta.
# En producción, apuntan al remoteEntry.js de su propio deploy en Vercel
# (VITE_CHAT_REMOTE_URL / VITE_MONITOREO_REMOTE_URL en GitHub Secrets).
VITE_CHAT_REMOTE_URL=http://localhost:5174/assets/remoteEntry.js
VITE_MONITOREO_REMOTE_URL=http://localhost:5175/assets/remoteEntry.js
