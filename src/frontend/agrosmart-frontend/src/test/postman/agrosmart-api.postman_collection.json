    {
      "name": "CP-API-001 - Precio de Cebolla",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "let datos = {};\r",
              "let respuesta = \"\";\r",
              "let esJson = false;\r",
              "\r",
              "try {\r",
              "    datos = pm.response.json();\r",
              "    esJson = true;\r",
              "\r",
              "    const contenido = Array.isArray(datos)\r",
              "        ? (datos[0] || {})\r",
              "        : datos;\r",
              "\r",
              "    respuesta =\r",
              "        contenido.respuesta ||\r",
              "        contenido.output ||\r",
              "        contenido.text ||\r",
              "        contenido.message ||\r",
              "        \"\";\r",
              "\r",
              "    if (typeof respuesta !== \"string\") {\r",
              "        respuesta = JSON.stringify(respuesta);\r",
              "    }\r",
              "} catch (error) {\r",
              "    respuesta = pm.response.text();\r",
              "}\r",
              "\r",
              "pm.test(\"CP-API-01: estado 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"CP-API-01: respuesta válida\", function () {\r",
              "    pm.expect(respuesta).to.be.a(\"string\");\r",
              "    pm.expect(respuesta.trim()).not.to.eql(\"\");\r",
              "});\r",
              "\r",
              "\r",
              "pm.test(\"CP-API-01: contiene precio y valor numérico\", function () {\r",
              "    pm.expect(respuesta).to.match(/precio|soles?|s\\/\\.?/i);\r",
              "    pm.expect(respuesta).to.match(/\\d+(?:[.,]\\d+)?/);\r",
              "});\r",
              "\r",
              "pm.test(\"CP-API-01: indica la unidad de medida\", function () {\r",
              "    pm.expect(respuesta).to.match(\r",
              "        /kilogramo?|kilos?|\\bkg\\b|sacos?|jabas?|cajas?|unidad/i\r",
              "    );\r",
              "});\r",
              "\r",
              "pm.test(\"CP-API-01: responde en menos de 30 segundos\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(30000);\r",
              "});"
