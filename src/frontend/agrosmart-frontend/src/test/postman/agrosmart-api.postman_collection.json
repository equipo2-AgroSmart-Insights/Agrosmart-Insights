    {
      "name": "CP-API-004 - Consulta de ingreso en kg",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "let json = {};\r",
              "let respuesta = \"\";\r",
              "\r",
              "try {\r",
              "    json = pm.response.json();\r",
              "\r",
              "    respuesta =\r",
              "        json.respuesta ||\r",
              "        json.text ||\r",
              "        json.output ||\r",
              "        \"\";\r",
              "} catch (error) {\r",
              "    respuesta = \"\";\r",
              "}\r",
              "\r",
              "const texto = String(respuesta)\r",
              "    .replace(/\\*\\*/g, \"\")\r",
              "    .replace(/\\u202f/g, \" \")\r",
              "    .replace(/\\s+/g, \" \")\r",
              "    .trim();\r",
              "\r",
              "const oraciones = texto.split(/[.!?\\n]+/);\r",
              "\r",
              "console.log(\"RESPUESTA VALIDADA:\", texto);\r",
              "\r",
              "pm.test(\"CP-API-04: estado 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"CP-API-04: respuesta JSON válida\", function () {\r",
              "    pm.response.to.be.json;\r",
              "    pm.expect(texto).not.to.eql(\"\");\r",
              "});\r",
              "\r",
              "pm.test(\"CP-API-04: menciona específicamente rocoto\", function () {\r",
              "    pm.expect(texto.toLowerCase()).to.include(\"rocoto\");\r",
              "});\r",
              "\r",
              "pm.test(\"CP-API-04: relaciona rocoto, volumen, cantidad y kilogramos\", function () {\r",
              "    const respuestaCorrecta = oraciones.some(function (oracion) {\r",
              "        const mencionaRocoto = /rocoto/i.test(oracion);\r",
              "        const mencionaVolumen = /volumen|cantidad|ingresaron?|ingreso/i.test(oracion);\r",
              "        const contieneCantidad = /\\d+(?:[\\s.,]\\d+)*/.test(oracion);\r",
              "        const contieneKilogramos =\r",
              "            /kilogramos?|\\bkilos?\\b|\\bkg\\b/i.test(oracion);\r",
              "\r",
              "        return (\r",
              "            mencionaRocoto &&\r",
              "            mencionaVolumen &&\r",
              "            contieneCantidad &&\r",
              "            contieneKilogramos\r",
              "        );\r",
              "    });\r",
              "\r",
              "    pm.expect(respuestaCorrecta).to.eql(true);\r",
              "});\r",
              "\r",
              "\r",
              "pm.test(\"CP-API-04: solamente responde sobre volumen de ingreso\", function () {\r",
              "    pm.expect(texto).not.to.match(\r",
              "        /contexto\\s+clim[aá]tico|tendencia\\s+de\\s+precios?|correlaci[oó]n\\s+hist[oó]rica|decisi[oó]n\\s+estrat[eé]gica|recomendaci[oó]n|acciones\\s+sugeridas|vender|esperar/i\r",
              "    );\r",
              "});\r",
              "\r",
              "pm.test(\"CP-API-04: no proporciona precios\", function () {\r",
              "    pm.expect(texto).not.to.match(\r",
              "        /precio\\s+actual|s\\/\\.?\\s*\\d+/i\r",
              "    );\r",
              "});\r",
              "\r",
              "pm.test(\"CP-API-04: respuesta breve y directa\", function () {\r",
              "    const cantidadPalabras = texto.split(/\\s+/).filter(Boolean).length;\r",
              "\r",
              "    pm.expect(cantidadPalabras).to.be.below(70);\r",
              "});\r",
              "\r",
              "pm.test(\"CP-API-04: responde en menos de 30 segundos\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(30000);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
