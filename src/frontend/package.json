{
  "name": "agrosmart-frontend-workspace",
  "private": true,
  "version": "1.0.0",
  "description": "Orquestador de microfrontends de AgroSmart Insights",
  "scripts": {
    "dev": "concurrently -k -n \"CHAT,SHELL\" -c \"cyan,green\" \"npm:preview:chat\" \"npm:dev:shell\"",
    "dev:shell": "cd agrosmart-frontend && npm run dev",
    "dev:chat": "cd chat-microfrontend && npm run dev",
    "build:chat": "cd chat-microfrontend && npm run build",
    "preview:chat": "cd chat-microfrontend && npm run build && npm run preview",
    "build:shell": "cd agrosmart-frontend && npm run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}

