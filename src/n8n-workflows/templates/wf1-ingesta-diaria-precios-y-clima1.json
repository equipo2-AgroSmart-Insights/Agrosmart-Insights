    {
      "parameters": {
        "jsCode": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\n// Obtener todos los items entrantes del nodo anterior\nconst items = $input.all();\nconst result = [];\n\nfor (const item of items) {\n  const data = item.json;\n\n  // Construir el nuevo objeto normalizado\n  // Accedemos al índice [0] de los arreglos en 'daily'\n  const normalizedData = {\n    fecha: data.daily.time[0],\n    ubicacion: \"Lima\", // Valor fijo por ahora, puedes hacerlo dinámico si lo necesitas\n    latitud: data.latitude,\n    longitud: data.longitude,\n    temperatura: data.daily.temperature_2m_mean[0],\n    precipitacion: data.daily.precipitation_sum[0],\n    humedad: data.daily.relative_humidity_2m_mean[0],\n    evapotranspiracion: data.daily.et0_fao_evapotranspiration[0]\n  };\n\n  // N8n requiere que la estructura de salida esté dentro de una propiedad 'json'\n  result.push({ json: normalizedData });\n}\n\nreturn result;"
      },
