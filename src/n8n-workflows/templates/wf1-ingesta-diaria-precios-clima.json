{
  "name": "WF1: Ingesta Diaria Precios y Clima",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst resultado = [];\n\nconst regiones = $items(\"Code in JavaScript Regiones productoras\");\n\nfor (const item of items) {\n  const clima = item.json.body ?? item.json;\n\n  if (!clima.daily?.time) {\n    continue;\n  }\n\n  // Identificar qué región corresponde a esta respuesta\n  let regionEncontrada = null;\n  let menorDistancia = Infinity;\n\n  for (const r of regiones) {\n    const region = r.json;\n\n    const distancia =\n      Math.abs(Number(clima.latitude) - Number(region.latitud)) +\n      Math.abs(Number(clima.longitude) - Number(region.longitud));\n\n    if (distancia < menorDistancia) {\n      menorDistancia = distancia;\n      regionEncontrada = region;\n    }\n  }\n\n  if (!regionEncontrada) {\n    continue;\n  }\n\n  // Crear una fila por cada día del pronóstico\n  for (let i = 0; i < clima.daily.time.length; i++) {\n\n    resultado.push({\n      json: {\n        region_id: regionEncontrada.region_id,\n        region: regionEncontrada.region,\n        ciudad_referencia: regionEncontrada.ciudad_referencia,\n\n        // Para mantener compatibilidad con tu tabla actual\n        ubicacion: regionEncontrada.region,\n\n        latitud: regionEncontrada.latitud,\n        longitud: regionEncontrada.longitud,\n\n        fecha: clima.daily.time[i],\n\n        temperatura:\n          clima.daily.temperature_2m_mean?.[i] ?? null,\n\n        precipitacion:\n          clima.daily.precipitation_sum?.[i] ?? null,\n\n        humedad:\n          clima.daily.relative_humidity_2m_mean?.[i] ?? null,\n\n        evapotranspiracion:\n          clima.daily.et0_fao_evapotranspiration?.[i] ?? null,\n\n        tipo_dato: \"pronostico\"\n      }\n    });\n  }\n}\n\nreturn resultado;"
      },
