    {
      "parameters": {
        "jsCode": "const html = $input.first().json.data;\n\n// 1. Calculamos la fecha de hoy en Perú (Lima)\nconst now = new Date(new Date().toLocaleString(\"en-US\", {timeZone: \"America/Lima\"}));\nconst year = now.getFullYear(); // 2026\nconst month = String(now.getMonth() + 1).padStart(2, '0'); // 08\nconst day = String(now.getDate()).padStart(2, '0'); // 13\nconst shortYear = String(year).slice(-2); // 26\n\nconst meses = [\"ene\", \"feb\", \"mar\", \"abr\", \"may\", \"jun\", \"jul\", \"ago\", \"set\", \"oct\", \"nov\", \"dic\"];\nconst monthName = meses[now.getMonth()]; // \"ago\"\n\n// El patrón exacto que buscamos para hoy: \"13ago26.pdf\"\nconst patronHoy = `${day}${monthName}${shortYear}.pdf`;\n\n// 2. Buscamos en el HTML si existe un enlace con ese patrón\nconst regex = new RegExp(`href=\"([^\"]*${patronHoy})\"`, \"i\");\nconst match = html.match(regex);\n\nlet pdfUrl = \"\";\n\nif (match) {\n    // ¡Lo encontró en la página web!\n    pdfUrl = match[1];\n    if (!pdfUrl.startsWith('http')) {\n        pdfUrl = 'https://siea.midagri.gob.pe' + pdfUrl;\n    }\n} else {\n    // Si no está en el HTML (MIDAGRI a veces tarda en actualizar la web), \n    // pero sabemos cómo estructuran sus carpetas, lo \"adivinamos\" y lo armamos nosotros:\n    pdfUrl = `https://siea.midagri.gob.pe/files/datos_estadisticas/diarias/mml/${year}/${month}/sisap-ingreso-gmml-${patronHoy}`;\n}\n\nreturn [{ json: { url_pdf: pdfUrl } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        208,
        0
      ],
      "id": "ed4fd92b-5501-484d-b569-6e7df5262c9c",
