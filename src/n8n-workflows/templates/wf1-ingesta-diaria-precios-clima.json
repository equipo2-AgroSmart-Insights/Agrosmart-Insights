    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  if (!item.json.text) continue;\n  \n  const text = item.json.text;\n  const lines = text.split('\\n').map(line => line.trim()).filter(line => line !== '');\n  \n  let fechaHistorica = new Date().toISOString().split('T')[0];\n  \n  if (item.json.info && item.json.info.CreationDate) {\n      const rawDate = item.json.info.CreationDate;\n      const year = rawDate.substring(2, 6);\n      const month = rawDate.substring(6, 8);\n      const day = rawDate.substring(8, 10);\n      fechaHistorica = `${year}-${month}-${day}`;\n  }\n\n  for (let i = 0; i < lines.length - 3; i++) {\n    const unidad = lines[i+2];\n    \n    if ([\"Kilogramo\", \"Atado\", \"Cajon\", \"Cajón\", \"Saco\", \"Bolsa\", \"Mano\", \"Docena\", \"Ciento\"].includes(unidad)) {\n      const producto = lines[i];\n      const volumenRaw = lines[i+1];\n      const preciosRaw = lines[i+3];\n      \n      const preciosArr = preciosRaw.split(' ').filter(p => p.trim() !== '');\n      \n      // PRECIOS: Corregido. \"Hoy\" es el índice 2.\n      let precioFinal = 0;\n      if (preciosArr.length > 2 && preciosArr[2] !== ':') {\n          precioFinal = parseFloat(preciosArr[2]);\n      } else if (preciosArr.length > 1 && preciosArr[1] !== ':') {\n          precioFinal = parseFloat(preciosArr[1]); // Respaldo: Ayer\n      }\n\n      const volumenesArr = volumenRaw.split(' ').filter(v => v.trim() !== '');\n      // VOLÚMENES: \"Hoy\" es el índice 1.\n      let volumenFinal = 0;\n      if (volumenesArr.length > 1 && volumenesArr[1] !== ':') {\n          volumenFinal = parseFloat(volumenesArr[1]);\n      } else if (volumenesArr.length > 0 && volumenesArr[0] !== ':') {\n          volumenFinal = parseFloat(volumenesArr[0]); // Respaldo: Ayer\n      }\n\n      if (!isNaN(precioFinal)) {\n          results.push({\n            json: {\n              fecha: fechaHistorica,\n              producto: producto,\n              mercado: \"GMML\",\n              precio: precioFinal,\n              volumen: volumenFinal,\n              unidad: unidad\n            }\n          });\n      }\n      i += 3; \n    }\n  }\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        784,
        0
      ],
