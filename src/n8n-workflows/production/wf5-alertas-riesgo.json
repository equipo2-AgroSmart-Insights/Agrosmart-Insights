    {
      "parameters": {
        "jsCode": "// Normaliza el cuerpo que envía alertas-microfrontend (alertasService.js).\n// No lanza errores: una solicitud inválida llega a SQL como acción 'invalid'\n// y vuelve al navegador como { error } con HTTP 200.\nconst body = $json.body ?? {};\nconst acciones = ['list', 'details', 'update'];\nconst accion = acciones.includes(body.action) ? body.action : 'invalid';\n\nconst alertId = /^\\d{1,18}$/.test(String(body.alert_id ?? '')) ? String(body.alert_id) : '';\nconst status = ['read', 'attended'].includes(body.status) ? body.status : String(body.status ?? '');\nconst sessionId = String(body.session_id ?? '').slice(0, 64);\n\nreturn [{ json: { accion, alert_id: alertId, status, session_id: sessionId } }];\n"
      },
      "id": "658b2db4-49b0-42b5-9cb4-273ebc5273e2",
      "name": "Code - Validar solicitud",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        460
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT CASE $1\n    WHEN 'list'    THEN public.alertas_riesgo_listar()\n    WHEN 'details' THEN public.alertas_riesgo_detalle(NULLIF($2, '')::bigint)\n    WHEN 'update'  THEN public.alertas_riesgo_actualizar(NULLIF($2, '')::bigint, $3, $4)\n    ELSE jsonb_build_object('error', 'Acción no soportada. Usa list, details o update.')\nEND AS resultado;",
        "options": {
          "queryReplacement": "={{ [ $json.accion, $json.alert_id, $json.status, $json.session_id ] }}"
        }
      },
      "id": "1d51039a-1f6a-4029-9ef3-e7eca48e83c3",
      "name": "Postgres - list / details / update",
      "type": "n8n-nodes-base.postgres",
