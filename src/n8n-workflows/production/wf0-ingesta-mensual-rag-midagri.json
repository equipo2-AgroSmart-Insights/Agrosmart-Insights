{
  "name": "WF0: Ingesta Mensual RAG - MIDAGRI",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const results = [];\n\n// ==========================================\n// CONFIGURACIÓN MANUAL PARA DATA ANTIGUA\n// ==========================================\nconst anioTarget = 2026; // Cambia esto al año que quieras\nconst mesTarget = 1;     // Cambia esto al mes que quieras (1 = Enero, 2 = Febrero, 3 = Marzo...)\n\nconst shortYear = String(anioTarget).slice(-2);\nconst monthNum = String(mesTarget).padStart(2, '0');\nconst meses = [\"ene\", \"feb\", \"mar\", \"abr\", \"may\", \"jun\", \"jul\", \"ago\", \"set\", \"oct\", \"nov\", \"dic\"];\nconst monthName = meses[mesTarget - 1];\n\n// Truco de JS para saber exactamente cuántos días tuvo ese mes (incluso si fue bisiesto)\nconst diasDelMes = new Date(anioTarget, mesTarget, 0).getDate();\n\n// Bucle desde el día 1 hasta el ÚLTIMO día de ese mes histórico\nfor (let day = 1; day <= diasDelMes; day++) {\n  // En JS, los meses empiezan en 0, por eso restamos 1 al mesTarget\n  const d = new Date(anioTarget, mesTarget - 1, day);\n  \n  // Nos saltamos domingos (0) y sábados (6)\n  if (d.getDay() === 0 || d.getDay() === 6) continue;\n\n  const paddedDay = String(day).padStart(2, '0');\n  const url = `https://siea.midagri.gob.pe/files/datos_estadisticas/diarias/mml/${anioTarget}/${monthNum}/sisap-ingreso-gmml-${paddedDay}${monthName}${shortYear}.pdf`;\n  \n  results.push({\n    json: {\n      fecha_archivo: `${paddedDay}/${monthNum}/${anioTarget}`,\n      url_pdf: url\n    }\n  });\n}\n\nreturn results;"
      },
